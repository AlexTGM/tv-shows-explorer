{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["react", "react-*", "@tanstack/*", "zod"],
										"message": "domain is framework-free (ARCHITECTURE.md › Domain)."
									},
									{
										"group": [
											"#/data/**",
											"#/app/**",
											"#/modules/**",
											"#/shared/**",
											"#/routes/**"
										],
										"message": "domain depends on nothing outside domain."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/data/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["react", "react-*", "@tanstack/*"],
										"message": "data adapters must not depend on UI or Query."
									},
									{
										"group": [
											"#/app/**",
											"#/modules/**",
											"#/routes/**",
											"#/shared/ui/**",
											"#/shared/hooks/**"
										],
										"message": "data may import only domain and shared/lib."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"#/domain/**",
											"#/data/**",
											"#/app/**",
											"#/modules/**",
											"#/routes/**"
										],
										"message": "shared must stay generic and import only shared."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/routes/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#/data/**"],
										"message": "routes reach data only through app (container, queries)."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/modules/**/View.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@tanstack/*",
											"zod",
											"#/domain/**",
											"#/data/**",
											"#/app/**",
											"#/shared/hooks/**",
											"#/shared/lib/**"
										],
										"message": "View is JSX only: take everything from ./usePresenter or props."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/modules/**/usePresenter.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#/data/**"],
										"message": "Presenter gets data via app queries / domain tasks, never data adapters."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/src/modules/*/*/*/**/usePresenter.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["#/data/**"],
										"message": "Presenter gets data via app queries / domain tasks, never data adapters."
									},
									{
										"group": ["@tanstack/react-router"],
										"message": "Only the module root reads/changes router state; nested components get props."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
